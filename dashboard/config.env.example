# Discord Affiliate Bot Dashboard Configuration
# Copy this file to config.env and fill in your actual values

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Base44 App Configuration
BASE44_APP_ID=your_base44_app_id_here
BASE44_FUNCTION_TOKEN=your_base44_function_token_here
API_BASE_URL=https://app.base44.com/api/
APP_PREVIEW_URL=https://your-app.base44app.com/

# Database Configuration (MongoDB Atlas)
MONGO_URI=your_mongodb_connection_string_here
DB_NAME=discord_bot_db

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# Optional: Custom port
PORT=5000
